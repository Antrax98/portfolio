# ┌────────────────────────────────────────────────────┐
# │ Plantilla. El .env de verdad NO va a este repo:    │
# │ se carga en Arcane, en el proyecto 'portfolio'.    │
# └────────────────────────────────────────────────────┘
# Arcane guarda estos valores fuera de git y los inyecta al desplegar. Es el
# único lugar del despliegue que no vive en el repositorio, y es a propósito:
# el repo es público.

# --- Base de datos ---
DB_NAME=portfolio
DB_USER=portfolio
DB_PASS=cambiame

# --- Autenticación ---
# openssl rand -base64 48
JWT_SECRET=cambiame
JWT_EXPIRES_IN=1h

# --- Límites de peticiones ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Dominio ---
# Opcional: el compose ya trae este valor por defecto.
APP_HOST=portfolio.arcane.proyectron.dedyn.io
